# Universal OpenAI-Compatible API configurations (used to hide model/provider brand completely)
AI_API_URL=https://
AI_API_KEY=your_api_key_here
AI_MODEL=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=your_ga4_measurement_id_here

# Highly-tuned Secret Prompts (Keep these secure in your .env and copy them to Vercel/Cloudflare settings)
# Note: Use literal \n for newlines in env variables for clean loading in Node.js
AI_SYSTEM_PROMPT_KARAOKE_TO_THAI="your_secret_karaoke_to_thai_system_prompt_here"
AI_SYSTEM_PROMPT_THAI_TO_KARAOKE="your_secret_thai_to_karaoke_system_prompt_here"
